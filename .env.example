# Copy to .env and edit locally. Never commit .env or paste its values into issues.
# IMAP over TLS, using an app password where required. OAuth2 is not implemented.
IMAP_HOST=imap.163.com
IMAP_PORT=993
IMAP_USER=your_email@example.invalid
IMAP_APP_PASSWORD=replace_with_app_password
IMAP_MAILBOX=INBOX
IMAP_TIMEOUT=30
IMAP_MAX_MESSAGE_BYTES=10485760

# Optional: NiuTrans English -> Chinese translation.
# Select cloud or neu to match your own account/API contract.
NIUTRANS_API_VARIANT=cloud
NIUTRANS_API_KEY=

# Optional: WxPusher App notifications; fields stay empty until configured.
WXPUSHER_APP_TOKEN=
WXPUSHER_UIDS=
